SELECT*
FROM bank_Products;
---- to get all information

SELECT *
FROM bank_products
ORDER BY monthly_fee desc;
--- monthly fee highest to lowes

SELECT AVG(monthly_fee)
FROM bank_products;
-- show average monthly fee

SELECT*
FROM Bank_products
WHERE interest_rate >0
ORDER BY interest_rate desc;
----- show all products with above zero interates rate from highest to lowest.

Select*
FROM Bank_products
WHERE Product_type = 'Savings'
AND interest_rate >= .2
ORDER BY interest_rate;
--- show all savings products with interest rate


SELECT product_name
FROM bank_products;
--- question 1 answered all product names

SELECT product_name
FROM bank_products
WHERE product_type = 'Checking'
OR 
product_type = 'Savings';
-- question 2 show all checking and savings products

SELECT product_name, interest_rate
FROM bank_products
WHERE product_type = 'Savings'
AND interest_rate > .75
AND monthly_fee = 0;
--- question 3 savings with interest rate above .75

