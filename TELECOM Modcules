SELECT * FROM customer_subscriptions LIMIT 5;

-- Query #1
--Write a query that selects the customer id of all the customers who are subscribed to Cell Phone service products.

SELECT customer_id
FROM customer_subscriptions
;

SELECT product_id
FROM products
WHERE product_type = 'Cell Phone Service'
;

SELECT customer_id
FROM customer_subscriptions
WHERE product_id IN (SELECT product_id FROM products WHERE product_type = 'Cell Phone Service')
;

-- Query 2 Write a query that will select the email address of all the customers with the "Internet" product type.

SELECT email
FROM customer_subscriptions
WHERE product_id IN (SELECT product_id FROM products WHERE product_type = 'Internet')
;

-- Query 3 Write a query that will select the emails of all customers who are paying more than the average price for internet.

SELECT email
FROM customer_subscriptions
WHERE price > (SELECT AVG(monthly_price) FROM products WHERE product_type = 'Internet')
;
